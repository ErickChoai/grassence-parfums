# Banco de dados PostgreSQL.
# Local: use Docker, Postgres.app ou um banco gratuito na nuvem (Neon, Supabase).
# Produção (Vercel): cole aqui a connection string do seu provedor.
# Se o provedor exigir SSL (Neon/Supabase geralmente exigem), mantenha ?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host:5432/grassence?sslmode=require"

# Sessão do admin. Gere uma string aleatória forte:
#   openssl rand -base64 32
SESSION_SECRET="troque-por-uma-string-aleatoria-forte"

# Credenciais do primeiro usuário admin (usadas só pelo script de seed)
ADMIN_EMAIL="contato@grassenceparfums.com.br"
ADMIN_NAME="Grassence Admin"
ADMIN_PASSWORD="troque-esta-senha"

# Mercado Pago (Checkout Pro): https://www.mercadopago.com.br/developers/panel
# Comece com as credenciais de TESTE (sandbox).
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# URL pública do site. Em produção use o domínio real (sem barra no final),
# pois ela monta as URLs de retorno do checkout e o webhook do Mercado Pago.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
